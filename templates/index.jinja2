{% import "/templates/shared/macros.jinja2" as macros with context %}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Addicting Word Games - Free Word Puzzles &amp; Typing Games</title>
    <meta name="description"
          content="Play free addicting word games online: Infinite Wordle, word search, word jumble, typing games and more. Instant play in your browser, no download.">
    <link rel="canonical" href="https://addictingwordgames.com/">
    <meta property="og:title" content="Addicting Word Games - Free Word Puzzles &amp; Typing Games">
    <meta property="og:url" content="https://addictingwordgames.com/">
    <meta property="og:image" content="https://addictingwordgames.com/static/img/og/home.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:description"
          content="Play free addicting word games online: Infinite Wordle, word search, word jumble, typing games and more.">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Addicting Word Games">
    <meta property="fb:admins" content="337972272904903">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Addicting Word Games - Free Word Puzzles &amp; Typing Games">
    <meta name="twitter:description" content="Play free addicting word games online: Infinite Wordle, word search, typing games and more.">
    <meta name="twitter:image" content="https://addictingwordgames.com/static/img/og/home.png">
    <script type="application/ld+json">
    {"@context":"https://schema.org","@graph":[
      {"@type":"WebSite","name":"Addicting Word Games","url":"https://addictingwordgames.com/"},
      {"@type":"Organization","name":"Addicting Word Games","url":"https://addictingwordgames.com/","logo":"https://addictingwordgames.com/static/img/addicting-word-games-icon200.png"},
      {"@type":"ItemList","name":"Free word games","itemListElement":[{% for g in awgutils.SELF_HOSTED_GAMES.values() %}{"@type":"ListItem","position":{{ loop.index }},"url":"https://addictingwordgames.com{{ g.path }}","name":"{{ g.title }}"}{% if not loop.last %},{% endif %}{% endfor %}]}
    ]}
    </script>

    {{ macros.headers(ws, highscores, achievements) }}

</head>
<body class="awg-home">
{{ macros.templates() }}
<div id="pagebody">
    {{ macros.topbar() }}

    <div id="searchbox">
        <form role="form" class="form-inline" style="display:none">
            <div class="form-group">
                <div class="row">
                    <div class="col-xs-6 col-sm-6 col-md-8"><input type="text" class="search-box form-control"
                                                                   id="exampleInputEmail1" placeholder="Search"></div>
                    <div class="col-xs-6 col-sm-6 col-md-4">
                        <button type="submit" class="btn btn-large btn-primary">Search</button>
                    </div>
                </div>
            </div>
        </form>
{#        <a class="btn btn-primary btn-large" href="{{ random_game_url }}">Random Addicting Word Game!</a>#}
    </div>
    {{ macros.hero() }}
    {{ macros.showgames() }}

    <div class="clear">
    </div>
    <div>
        {{ macros.loadmorebutton() }}
    </div>

    <div class="clear">
    </div>
    {{ macros.siblings() }}
    {{ macros.footer() }}
    <div class="clear">
    </div>
</div>

</body>
</html>
